#
# Reject any commit message that credits a tool, assistant or vendor.
#
# Authorship on this repository is human and singular. Tools do not appear as
# authors, contributors, co-authors or generation credits -- not in commits,
# not in documentation, not in metadata. A rule that is only written down gets
# forgotten, so it is enforced here instead.
#
# Enable once per clone:
#     git config core.hooksPath .githooks

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Comment lines are stripped before the message is stored, so ignore them.
body=$(grep -v '^#' "$msg_file")

forbidden='Co-authored-by|Co-Authored-By|Generated by|Created with|AI-generated|Assisted-by|Claude|Codex|Copilot|ChatGPT|Anthropic|OpenAI|Gemini|Cursor'

hit=$(printf '%s\n' "$body" | grep -inE "$forbidden")
if [ -n "$hit" ]; then
    echo "commit-msg: refusing a message that credits a tool or vendor." >&2
    echo "" >&2
    printf '%s\n' "$hit" | sed 's/^/    /' >&2
    echo "" >&2
    echo "Authorship here is human and singular. Remove the line and commit again." >&2
    exit 1
fi

exit 0
