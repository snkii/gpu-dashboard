#
# Reject any commit message that credits a tool, assistant or vendor.
#
# Authorship on this repository is human and singular. Tools do not appear as
# authors, contributors, co-authors or generation credits -- not in commits,
# not in documentation, not in metadata. A rule that is only written down gets
# forgotten, so it is enforced here instead.
#
# What this does NOT block: naming a product the code actually uses. This
# repository calls the Gemini API, so it has to be able to say "Gemini" and
# "gemini-3.1-flash-lite" in a message describing that code. An earlier version
# matched vendor names anywhere and refused a commit for documenting its own
# dependency. The rule is about attribution, so only attribution is matched.
#
# Enable once per clone:
#     git config core.hooksPath .githooks

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Comment lines are stripped before the message is stored, so ignore them.
body=$(grep -v '^#' "$msg_file")

# 1. Attribution trailers and phrasings, whoever is being credited.
phrasings='Co-authored-by|Co-Authored-By|Assisted-by|Generated-by|Generated by|Created with|Written by|Authored by|AI-generated|AI generated|with the help of'

# 2. A tool or vendor named in a credit position -- after "by", "with",
#    "thanks to", or on a trailer line. Naming one in prose is fine.
tools='Claude|Codex|Copilot|ChatGPT|Anthropic|OpenAI|Gemini|Cursor|Devin'
credited="(^|[^A-Za-z])(by|with|from|thanks to)[[:space:]]+($tools)([^A-Za-z]|$)"
trailer="^[A-Za-z-]+-by:.*($tools)"

hit=$(printf '%s\n' "$body" | grep -inE "$phrasings")
hit="$hit$(printf '%s\n' "$body" | grep -inE "$credited")"
hit="$hit$(printf '%s\n' "$body" | grep -inE "$trailer")"

if [ -n "$(printf '%s' "$hit" | tr -d '[:space:]')" ]; then
    echo "commit-msg: refusing a message that credits a tool or vendor." >&2
    echo "" >&2
    printf '%s\n' "$hit" | grep -v '^$' | sed 's/^/    /' >&2
    echo "" >&2
    echo "Authorship here is human and singular. Remove the credit and commit again." >&2
    echo "(Naming a tool the code uses is fine -- this matches attribution only.)" >&2
    exit 1
fi

exit 0
